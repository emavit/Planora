<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Planora</AssemblyName>
    <RootNamespace>ProjectDesk</RootNamespace>
    <Product>Planora</Product>
    <Company>Planora</Company>
    <Title>Planora</Title>
    <Description>Offline project planning with reviewed AI assistance</Description>
    <Version>0.3.12</Version>
    <ApplicationIcon Condition="Exists('Resources/Planora.ico')">Resources/Planora.ico</ApplicationIcon>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/ProjectCommands.json" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.13" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.13" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.13" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <ProjectReference Include="../vendor/OfficeIMO/OfficeIMO.Project/OfficeIMO.Project.csproj" />
  </ItemGroup>
</Project>
